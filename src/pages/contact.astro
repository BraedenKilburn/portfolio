---
import Layout from '@/layouts/Layout.astro'
import Button from '@/components/Button.astro'
import SocialCard from '@/components/SocialCard.astro'
import { getCollection } from 'astro:content'

const socialsEntries = await getCollection('socials')
const socials = socialsEntries.map((entry) => entry.data)
---

<Layout
  title="Contact - Braeden Kilburn"
  description="Get in touch with Braeden Kilburn. Open to new opportunities, collaborations, and interesting projects. Connect through professional channels for discussions about technology and development."
>
  <main class="contact-page">
    <section class="hero">
      <h1>Get in Touch</h1>
      <p class="intro">
        Have a project, opportunity, or question? Reach out through one of the
        channels below and I'll get back to you.
      </p>
    </section>

    <section class="contact-methods">
      <h2>Let's Connect</h2>
      <p class="subtitle">
        The best way to reach me is through these professional channels.
      </p>

      <div class="social-links">
        {
          socials.map((social) => (
            <SocialCard
              label={social.label}
              href={social.href}
              description={social.description}
            />
          ))
        }
      </div>
    </section>

    <section class="availability">
      <h2>Current Availability</h2>
      <div class="availability-card">
        <div class="status-indicator available"></div>
        <div class="availability-content">
          <h3>Open to Opportunities</h3>
          <p>
            I'm open to frontend-focused roles, collaborations, and practical
            web projects where thoughtful UI work matters.
          </p>
        </div>
      </div>
    </section>

    <section id="resume" class="resume">
      <h2>Resume</h2>
      <p>
        A current resume PDF is not published on the site yet. For now, contact
        me directly and I'll send the latest version with my experience,
        projects, and technical skills.
      </p>
      <Button href="mailto:him@braedenkilburn.com">Request Resume</Button>
    </section>

    <section class="cta">
      <h2>Ready to Start Something Great?</h2>
      <p>Let's discuss how we can work together to bring your ideas to life.</p>
      <div class="cta-buttons">
        <Button href="/projects">View My Work</Button>
        <Button href="/about" variant="secondary">Learn More About Me</Button>
      </div>
    </section>
  </main>
</Layout>

<style>
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
    }
  }

  .contact-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .hero {
    text-align: center;

    h1 {
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 700;
      margin-bottom: 1.5rem;
      color: var(--text-primary);
    }

    .intro {
      font-size: 1.25rem;
      line-height: 1.7;
      color: var(--text-secondary);
      max-width: 70ch;
      margin: 0 auto;
    }
  }

  .contact-methods {
    text-align: center;

    h2 {
      font-size: 2.5rem;
      font-weight: 600;
      margin-bottom: 1rem;
      color: var(--color-accent);
    }

    .subtitle {
      font-size: 1.1rem;
      color: var(--text-secondary);
      margin-bottom: 3rem;
    }

    .social-links {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
    }
  }

  .availability {
    h2 {
      font-size: 2.5rem;
      font-weight: 600;
      margin-bottom: 2rem;
      text-align: center;
      color: var(--color-accent);
    }

    .availability-card {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      padding: 1.5rem;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 12px;

      .status-indicator {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        flex-shrink: 0;

        &.available {
          background: #10b981;
          box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.2);
          animation: pulse 2s infinite;
        }
      }

      .availability-content {
        h3 {
          font-size: 1.5rem;
          font-weight: 600;
          margin: 0 0 0.5rem 0;
          color: var(--text-primary);
        }

        p {
          font-size: 1rem;
          line-height: 1.6;
          color: var(--text-secondary);
          margin: 0;
        }
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .availability {
      .availability-card {
        .status-indicator.available {
          animation: none;
        }
      }
    }
  }

  .cta {
    text-align: center;
    background: var(--bg-secondary);
    border-radius: 12px;
    padding: 3rem 2rem;
    border: 1px solid var(--border-color);

    h2 {
      font-size: 2.5rem;
      font-weight: 600;
      margin-bottom: 1rem;
      color: var(--color-accent);
    }

    p {
      font-size: 1.1rem;
      color: var(--text-secondary);
      margin-bottom: 2rem;
    }

    .cta-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }
  }

  .resume {
    text-align: center;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 2rem;

    h2 {
      font-size: 2.5rem;
      font-weight: 600;
      margin-bottom: 1rem;
      color: var(--color-accent);
    }

    p {
      color: var(--text-secondary);
      line-height: 1.7;
      margin: 0 auto 1.5rem;
      max-width: 62ch;
    }
  }

  @media (max-width: 768px) {
    .contact-page {
      padding: 1rem 0.5rem;
      gap: 3rem;
    }

    .social-links {
      grid-template-columns: 1fr;
    }

    .availability-card {
      flex-direction: column;
      text-align: center;
      padding: 1.5rem;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: center;

      > * {
        width: 100%;
        max-width: 300px;
      }
    }
  }
</style>
