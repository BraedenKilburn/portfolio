---
import Layout from '@/layouts/Layout.astro'
import Hero from '@/components/Hero.astro'
import FeaturedProjects from '@/components/FeaturedProjects.astro'
---

<Layout>
  <main>
    <Hero />
    <section class="about">
      <div class="about-content">
        <div>
          <h2>About Me</h2>
          <p>
            I'm a front-end engineer based in Las Vegas with production
            experience building Vue, TypeScript, and Node.js applications. I
            care about responsive UI systems, performance, accessibility, and
            collaboration - the details that help teams ship web products that
            are easier to use and maintain.
          </p>
        </div>
        <ul class="values">
          <li>
            <strong>Production front-end experience</strong>
            <span>Building and maintaining user-facing features in real software teams.</span>
          </li>
          <li>
            <strong>Maintainable component systems</strong>
            <span>Reusable UI patterns that make products easier to extend.</span>
          </li>
          <li>
            <strong>Performance and accessibility polish</strong>
            <span>Fast, responsive interfaces that stay usable across devices.</span>
          </li>
        </ul>
      </div>
    </section>
    <FeaturedProjects heading="Featured Projects" />
  </main>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    min-height: 92vh;

    .about {
      margin: 0 1rem 4rem;
      width: 100%;

      .about-content {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(280px, 0.8fr);
        align-items: center;
        gap: 2.5rem;

        h2 {
          font-size: 2rem;
          margin-bottom: 1rem;
        }

        p {
          color: var(--text-muted);
          line-height: 1.7;
          font-size: 1.1rem;
          max-width: 65ch;
          margin: 0;
        }

        .values {
          display: flex;
          flex-direction: column;
          gap: 1rem;
          padding: 0;
          margin: 0;
          list-style: none;

          li {
            flex-direction: column;
            display: flex;
            gap: 0.25rem;
            padding: 1rem 0;
            border-bottom: 1px solid var(--border-color);

            &:last-child {
              border-bottom: none;
            }

            strong {
              color: var(--text-primary);
            }

            span {
              color: var(--text-muted);
            }
          }
        }
      }

      @media (max-width: 768px) {
        .about-content {
          grid-template-columns: 1fr;
          text-align: center;

          p {
            margin: 0 auto;
          }
        }
      }
    }
  }
</style>
