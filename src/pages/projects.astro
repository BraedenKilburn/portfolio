---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/Button.astro";
import ProjectCard from "@/components/ProjectCard.astro";
const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.priority - a.data.priority,
);
---

<Layout>
  <main class="projects-page">
    <h1>Projects</h1>
    <p class="intro">
      A collection of projects that show how I approach front-end architecture,
      full-stack integration, and developer experience. Each one highlights a
      different part of my workflow.
    </p>

    <div class="grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>

    <section class="cta">
      <h2>Interested in Working Together?</h2>
      <p>
        I'm always excited to take on new challenges and collaborate on
        interesting projects. Whether you have a specific project in mind or
        just want to discuss ideas, I'd love to hear from you.
      </p>
      <div class="cta-buttons">
        <Button href="/contact">Get in Touch</Button>
        <Button href="/about" variant="secondary">Learn More About Me</Button>
      </div>
    </section>
  </main>
</Layout>

<style>
  .projects-page {
    max-width: 1000px;
    margin: 4rem auto;
    padding: 0 1rem;
  }

  h1 {
    font-size: 2.5rem;
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .intro {
    text-align: center;
    color: var(--text-secondary);
    max-width: 65ch;
    margin: 0 auto 3rem;
    line-height: 1.7;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 4rem;

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
    }
  }

  .cta {
    text-align: center;
    background: var(--bg-secondary);
    border-radius: 12px;
    padding: 3rem 2rem;
    border: 1px solid var(--border-color);

    h2 {
      font-size: 2.5rem;
      font-weight: 600;
      margin-bottom: 1rem;
      color: var(--color-accent);
    }

    p {
      font-size: 1.1rem;
      color: var(--text-secondary);
      margin-bottom: 2rem;
      max-width: 60ch;
      margin-left: auto;
      margin-right: auto;
    }

    .cta-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 768px) {
    .projects-page {
      padding: 0 0.5rem;
    }

    .cta {
      padding: 2rem 1.5rem;

      h2 {
        font-size: 2rem;
      }

      .cta-buttons {
        flex-direction: column;
        align-items: center;

        > * {
          width: 100%;
          max-width: 300px;
        }
      }
    }
  }
</style>
