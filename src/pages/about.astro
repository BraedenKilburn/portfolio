---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/Button.astro";
import ExperienceItem from "@/components/ExperienceItem.astro";
import SkillCategory from "@/components/SkillCategory.astro";
import { getCollection } from "astro:content";

const experienceEntries = await getCollection("experience");
const experience = experienceEntries.sort(
  (a, b) => a.data.order - b.data.order,
);

const skillsEntries = await getCollection("skills");
const skills = skillsEntries.sort((a, b) => a.data.order - b.data.order);
---

<Layout>
  <main class="about-page">
    <section class="hero">
      <h1>About Me</h1>
      <p class="intro">
        I'm a passionate full-stack developer with over 5 years of experience
        building intuitive, performant web applications. I love bringing design
        and engineering together to create solutions that make a real impact.
      </p>
    </section>

    <section class="experience">
      <h2>Professional Experience</h2>

      {experience.map((entry) => <ExperienceItem experience={entry} />)}
    </section>

    <section class="skills">
      <h2>Technical Skills</h2>
      <div class="skills-grid">
        {
          skills.map((skillCategory) => (
            <SkillCategory skillCategory={skillCategory} />
          ))
        }
      </div>
    </section>

    <section class="personal">
      <h2>Beyond Code</h2>
      <p>
        While I thrive on building elegant web experiences, my life outside of
        development is just as engaging. You'll often find me cheering for my
        favorite football or volleyball teams, playing video games with friends,
        or catching the latest movie releases. I'm a dedicated husband and
        father, finding immense joy and purpose in spending quality time with my
        family and contributing to my local community.
      </p>
    </section>

    <section class="cta">
      <h2>Let's Work Together</h2>
      <p>I'm always interested in new opportunities and exciting projects.</p>
      <div class="cta-buttons">
        <Button href="/contact">Get in Touch</Button>
        <Button href="/projects" variant="secondary">View My Work</Button>
      </div>
    </section>
  </main>
</Layout>

<style>
  .about-page {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1rem;

    .hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2rem;
      text-align: center;

      h1 {
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 700;
        color: var(--text-primary);
      }
    }

    .intro {
      font-size: 1.25rem;
      line-height: 1.7;
      color: var(--text-secondary);
      max-width: 70ch;
      margin: 0 auto;
    }

    .experience {
      display: flex;
      flex-direction: column;
      gap: 2rem;

      h2 {
        font-size: 2.5rem;
        font-weight: 600;
        text-align: center;
      }
    }

    .skills {
      h2 {
        font-size: 2.5rem;
        font-weight: 600;
        margin-bottom: 2rem;
        text-align: center;
      }

      .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
      }
    }

    .personal {
      text-align: center;

      h2 {
        font-size: 2.5rem;
        font-weight: 600;
        margin-bottom: 2rem;
        color: var(--color-accent);
      }

      p {
        font-size: 1.1rem;
        line-height: 1.7;
        color: var(--text-secondary);
        max-width: 70ch;
        margin: 0 auto 1.5rem;
      }
    }

    .cta {
      text-align: center;
      background: var(--card-bg);
      border-radius: 12px;
      padding: 3rem 2rem;
      border: 1px solid var(--border-color);

      h2 {
        font-size: 2.5rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--color-accent);
      }

      p {
        font-size: 1.1rem;
        color: var(--text-secondary);
        margin-bottom: 2rem;
      }

      .cta-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
      }
    }

    @media (max-width: 768px) {
      padding: 1rem 0.5rem;

      .cta {
        .cta-buttons {
          flex-direction: column;
          align-items: center;

          > * {
            width: 100%;
            max-width: 300px;
          }
        }
      }
    }
  }
</style>
