---
import Button from "@/components/Button.astro";
import type { CollectionEntry } from "astro:content";
interface Props {
  project: CollectionEntry<"projects">;
}

const { title, description, tech, highlight, liveUrl, repoUrl, role, impact, slug } =
  Astro.props.project.data;
---

<article class="project-card">
  <div class="content">
    <h3>{title}</h3>
    <p class="description">{description}</p>
    {highlight && <p class="highlight">{highlight}</p>}
    {role && <p class="proof"><strong>Role:</strong> {role}</p>}
    {impact && <p class="proof"><strong>Impact:</strong> {impact}</p>}

    <ul class="tech-list">
      {tech.map((t) => <li>{t}</li>)}
    </ul>
    <div class="links">
      {
        liveUrl && (
          <Button href={liveUrl} external>
            View Live
          </Button>
        )
      }
      {
        slug && (
          <Button href={`/projects/${slug}`} variant="secondary">
            Case Study
          </Button>
        )
      }
      {
        repoUrl && (
          <Button href={repoUrl} external variant="secondary">
            Code
          </Button>
        )
      }
    </div>
  </div>
</article>

<style>
  .project-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-top: 3px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition:
      box-shadow 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;

    &:hover {
      border-color: color-mix(in srgb, var(--color-accent) 38%, var(--border-color));
      box-shadow: var(--shadow-md);
      transform: translateY(-3px);
    }

    .content {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      height: 100%;

      h3 {
        font-size: 1.25rem;
      }

      .description {
        color: var(--text-secondary);
        line-height: 1.6;
      }

      .highlight {
        color: var(--text-muted);
        border-left: 2px solid var(--color-accent);
        padding-left: 0.75rem;
        margin: 0.25rem 0;
        font-size: 0.95rem;
        line-height: 1.55;
      }

      .proof {
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.55;

        strong {
          color: var(--text-secondary);
        }
      }

      .tech-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: auto;
        padding: 0;
        list-style: none;

        li {
          background: var(--bg-tertiary);
          color: var(--text-muted);
          padding: 0.2rem 0.65rem;
          border-radius: 9999px;
          font-size: 0.8rem;
        }
      }

      .links {
        display: flex;
        gap: 1rem;
        margin-top: 0.5rem;

        @media (max-width: 768px) {
          flex-direction: column;
        }
      }
    }
  }
</style>
