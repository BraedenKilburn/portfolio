---
import Button from "@/components/Button.astro";
import SocialCard from "@/components/SocialCard.astro";
import { getCollection } from "astro:content";

const socialsEntries = await getCollection("socials");
const socials = socialsEntries.map((entry) => entry.data);
---

<section class="about">
  <div class="about-content">
    <h2>About Me</h2>
    <p>
      I'm a developer who loves crafting intuitive, performant web experiences
      that bring design and engineering together. My background in front‑end
      development gives me a strong eye for detail, while my full‑stack
      experience helps me create reliable, scalable solutions.
    </p>

    <div class="social-links">
      {socials.map((social) => (
        <SocialCard
          label={social.label}
          href={social.href}
          description={
            social.label === "Email"
              ? "Send me a message"
              : `Follow me on ${social.label}`
          }
        />
      ))}
    </div>

    <div class="ctas">
      <Button href="/about" variant="secondary"> Learn More </Button>
      <Button href="/contact"> Get in Touch </Button>
    </div>
  </div>
</section>

<style>
  .about {
    margin: 0 1rem 4rem;
    max-width: 800px;

    .about-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
      text-align: center;

      h2 {
        font-size: 2rem;
      }

      p {
        color: var(--text-muted);
        line-height: 1.7;
        font-size: 1.1rem;
        max-width: 65ch;
        margin: 0 auto;
      }

      .social-links {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
        margin: 1rem 0;

        > * {
          flex: 1;
          min-width: 200px;
          max-width: 300px;
        }
      }

      .ctas {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
      }
    }
  }

  @media (max-width: 768px) {
    .about {
      .about-content {
        .social-links {
          flex-direction: column;
          align-items: center;

          > * {
            width: 100%;
            max-width: 400px;
          }
        }

        .ctas {
          flex-direction: column;
          align-items: center;

          > * {
            width: 100%;
            max-width: 200px;
          }
        }
      }
    }
  }
</style>
