---
import Button from "@/components/Button.astro";
---

<section class="about">
  <div class="about-content">
    <h2>About Me</h2>
    <p>
      I'm a developer who loves crafting intuitive, performant web experiences
      that bring design and engineering together. My background in front‑end
      development gives me a strong eye for detail, while my full‑stack
      experience helps me create reliable, scalable solutions.
    </p>
    <div class="ctas">
      <Button href="/about" variant="secondary"> Learn More </Button>
      <Button href="/contact"> Get in Touch </Button>
    </div>
  </div>
</section>

<style>
  .about {
    padding: 4rem 1rem;
    max-width: 800px;
    margin: 0 auto;

    .about-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
      text-align: center;

      h2 {
        font-size: 2rem;
      }

      p {
        color: var(--text-secondary);
        line-height: 1.7;
        font-size: 1.1rem;
        max-width: 65ch;
        margin: 0 auto;
      }

      .ctas {
        display: flex;
        gap: 1rem;
      }
    }
  }
</style>
