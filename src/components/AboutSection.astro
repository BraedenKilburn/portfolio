---
import Button from "@/components/Button.astro";
interface Props {
  heading?: string;
  summary?: string;
  moreLink?: string;
}

const {
  heading = "About Me",
  summary = `I'm a developer who loves crafting intuitive, performant web experiences that bring design and engineering together. My background in front‑end development gives me a strong eye for detail, while my full‑stack experience helps me create reliable, scalable solutions.`,
  moreLink = "/about",
} = Astro.props;
---

<section class="about">
  <div class="about-content">
    <h2>{heading}</h2>
    <p>{summary}</p>
    {moreLink && <Button variant="secondary">Learn More</Button>}
  </div>
</section>

<style>
  .about {
    padding: 4rem 1rem;
    max-width: 800px;
    margin: 0 auto;

    .about-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
      text-align: center;

      h2 {
        font-size: 2rem;
      }

      p {
        color: var(--text-secondary);
        line-height: 1.7;
        font-size: 1.1rem;
        max-width: 65ch;
        margin: 0 auto;
      }
    }
  }
</style>
