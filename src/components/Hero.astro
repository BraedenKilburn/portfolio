---
import { Image } from 'astro:assets'
import cartoonBraeden from '@/assets/cartoon-braeden.png'
import Button from '@/components/Button.astro'
---

<section class="hero">
  <div class="content">
    <h1>Hey, I'm Braeden!</h1>
    <p>
      Front-end engineer in Las Vegas specializing in Vue, TypeScript, and
      fast, accessible web apps. I bring a full-stack foundation, production
      experience, and a detail-oriented eye for interfaces that feel effortless
      to use.
    </p>
    <ul class="strengths" aria-label="Frontend strengths">
      <li>Vue + TypeScript</li>
      <li>Accessible UI architecture</li>
      <li>Performance-minded implementation</li>
      <li>Full-stack product context</li>
    </ul>
    <div class="ctas">
      <Button href="/projects">View Projects</Button>
      <Button href="/contact" variant="secondary">Get in Touch</Button>
    </div>
  </div>
  <div class="image">
    <Image src={cartoonBraeden} alt="Cartoon illustration of Braeden" />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2rem;
    margin: 2rem 0 4rem;

    h1 {
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 700;
      margin-bottom: 1rem;
    }

    p {
      font-size: 1.125rem;
      line-height: 1.6;
      color: var(--text-muted);
    }

    .strengths {
      display: flex;
      flex-wrap: wrap;
      gap: 0.625rem;
      padding: 0;
      margin: 1.5rem 0 0;
      list-style: none;

      li {
        color: var(--text-secondary);
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 9999px;
        padding: 0.35rem 0.75rem;
        font-size: 0.9rem;
      }
    }

    .ctas {
      display: flex;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .image {
      display: flex;
      justify-content: center;

      img {
        max-width: 100%;
        height: auto;
      }
    }

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
      gap: 1rem;
      text-align: center;

      .image {
        order: -1;
      }

      .ctas {
        justify-content: center;
      }

      .strengths {
        justify-content: center;
      }
    }
  }
</style>
