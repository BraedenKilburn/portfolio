---
import { Image } from "astro:assets";
import cartoonImage from "@/assets/cartoon-braeden.png";

interface Props {
  greeting?: string;
  name?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  greeting = "Hey, I'm",
  name = "Braeden",
  description = "I'm a full-stack developer passionate about web development and design",
  image = cartoonImage,
  imageAlt = "Cartoon illustration of Braeden",
} = Astro.props;
---

<section class="hero">
  <div class="content">
    <h1>
      {greeting}
      <span class="name">{name}!</span>
    </h1>
    <p>{description}</p>
  </div>
  <div class="image">
    <Image src={image} alt={imageAlt} />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    margin: 2rem 0 4rem;

    h1 {
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 700;
      margin-bottom: 1rem;

      .name {
        color: var(--accent-color);
      }
    }

    p {
      font-size: 1.125rem;
      line-height: 1.6;
      color: var(--text-secondary);
    }

    .image {
      display: flex;
      justify-content: center;

      img {
        max-width: 100%;
        height: auto;
      }
    }

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
      text-align: center;

      .image {
        order: -1;
      }
    }
  }
</style>
