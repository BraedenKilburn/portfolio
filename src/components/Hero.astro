---
import { Image } from "astro:assets";
import cartoonImage from "@/assets/cartoon-braeden.png";
import Button from "@/components/Button.astro";
---

<section class="hero">
  <div class="content">
    <h1>
      Hey, I'm
      <span class="name">Braeden!</span>
    </h1>
    <p>
      I'm a full-stack developer passionate about web development and design
    </p>
    <div class="ctas">
      <Button href="/about">Learn More</Button>
      <Button href="/contact" variant="secondary">Get in Touch</Button>
    </div>
  </div>
  <div class="image">
    <Image src={cartoonImage} alt="Cartoon illustration of Braeden" />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    margin: 2rem 0 4rem;

    h1 {
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 700;
      margin-bottom: 1rem;

      .name {
        color: var(--accent-color);
      }
    }

    p {
      font-size: 1.125rem;
      line-height: 1.6;
      color: var(--text-muted);
    }

    .ctas {
      display: flex;
      gap: 1rem;
    }

    .image {
      display: flex;
      justify-content: center;

      img {
        max-width: 100%;
        height: auto;
      }
    }

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
      text-align: center;

      .image {
        order: -1;
      }
    }
  }
</style>
