---
import { Image } from 'astro:assets'
import cartoonBraeden from '@/assets/cartoon-braeden.png'
import Button from '@/components/Button.astro'
---

<section class="hero">
  <div class="content">
    <h1>Hey, I'm Braeden!</h1>
    <p>
      I am a frontend engineer with a full-stack foundation, focused on building
      intuitive, performant web experiences.
    </p>
    <div class="ctas">
      <Button href="/about">About Me</Button>
      <Button href="/contact" variant="secondary">Get in Touch</Button>
    </div>
  </div>
  <div class="image">
    <Image src={cartoonBraeden} alt="Cartoon illustration of Braeden" />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    margin: 2rem 0 4rem;

    h1 {
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 700;
      margin-bottom: 1rem;
    }

    p {
      font-size: 1.125rem;
      line-height: 1.6;
      color: var(--text-muted);
    }

    .ctas {
      display: flex;
      gap: 1rem;
    }

    .image {
      display: flex;
      justify-content: center;

      img {
        max-width: 100%;
        height: auto;
      }
    }

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
      gap: 1rem;
      text-align: center;

      .image {
        order: -1;
      }

      .ctas {
        justify-content: center;
      }
    }
  }
</style>
