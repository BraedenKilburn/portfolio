---
import MoonStarsIcon from "@/assets/moon-stars-icon.svg";
import LightModeIcon from "@/assets/light-mode-icon.svg";
---

<button class="theme-toggle" aria-label="Toggle theme" aria-pressed="false">
  <LightModeIcon class="light-icon" />
  <MoonStarsIcon class="dark-icon" />
</button>

<script is:inline>
  const themeToggle = document.querySelector(".theme-toggle");

  function applyTheme(isDark) {
    document.body.classList.toggle("dark-mode", isDark);
    localStorage.setItem("theme", isDark ? "dark" : "light");
    themeToggle?.setAttribute("aria-pressed", String(isDark));
  }

  const prefersDarkScheme = window.matchMedia("(prefers-color-scheme: dark)");
  const savedTheme = localStorage.getItem("theme");
  const isDark = savedTheme ? savedTheme === "dark" : prefersDarkScheme.matches;
  applyTheme(isDark);

  if (!savedTheme) {
    prefersDarkScheme.addEventListener("change", (e) => applyTheme(e.matches));
  }
  themeToggle?.addEventListener("click", () => {
    const isDarkNow = document.body.classList.contains("dark-mode");
    applyTheme(!isDarkNow);
  });
</script>

<style>
  @keyframes star-bounce {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }

    45% {
      transform: translateY(-2px) scale(1.1);
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .theme-toggle {
    fill: var(--text-primary);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 0.375rem;

    .light-icon {
      display: block;

    }

    &:hover .light-icon {
      animation: spin 8s linear infinite both;
    }

    .dark-icon {
      display: none;
      transition: transform 0.35s ease;
    }

    &:hover .dark-icon {
      transform: rotate(-12deg) scale(1.08);

      :global(.star-large) {
        animation: star-bounce 580ms;
      }

      :global(.star-small) {
        animation: star-bounce 580ms 80ms;
      }
    }

    &[aria-pressed="true"] {
      .light-icon {
        display: none;
      }

      .dark-icon {
        display: block;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      .light-icon,
      .dark-icon {
        transition: none;
      }

      &:hover .light-icon,
      &:hover .dark-icon {
        transform: none;
      }

      &:hover .light-icon :global(.sun-ray),
      &:hover .dark-icon :global(.star-large),
      &:hover .dark-icon :global(.star-small) {
        animation: none;
      }
    }
  }
</style>
