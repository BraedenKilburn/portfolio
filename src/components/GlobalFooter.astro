---
import Button from "@/components/Button.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

type Social = CollectionEntry<"socials">;
const socials = await getCollection("socials");

const name = "Braeden Kilburn";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <p class="brand">© {year} {name}. All rights reserved.</p>

    <nav class="socials">
      {
        socials.map((s: Social) => (
          <Button href={s.data.href} external variant="ghost">
            {s.data.label}
          </Button>
        ))
      }
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: 2rem 1rem;
    border-top: 1px solid var(--border-color);
    width: 100vw;
    margin-left: calc(50% - 50.5vw);

    .inner {
      max-width: 1000px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;

      @media (min-width: 768px) {
        flex-direction: row;
        justify-content: space-between;

        .brand {
          text-align: left;
        }
      }

      .brand {
        margin: 0;
        text-align: center;
      }

      .socials {
        display: flex;
        gap: 1.5rem;
      }
    }
  }
</style>
